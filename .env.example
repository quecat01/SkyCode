# Sky Code — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# The base URL of your LiteLLM server (include /v1 at the end)
LITELLM_API_URL=http://YOUR_LITELLM_HOST:4000/v1

# Your LiteLLM API key.
# This is the same value as LITELLM_MASTER_KEY in /etc/litellm.env on your LiteLLM server.
# On this machine it is called LITELLM_API_KEY.
LITELLM_API_KEY=your_litellm_master_key_here
